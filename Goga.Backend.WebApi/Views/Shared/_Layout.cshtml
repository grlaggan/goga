<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Goga — @ViewData["Title"]</title><style>
*{box-sizing:border-box}body{margin:0;min-height:100vh;font:16px system-ui,sans-serif;color:#1d2433;background:#f4f6fa}header{display:flex;justify-content:space-between;align-items:center;padding:18px max(24px,calc((100% - 1000px)/2));background:#fff;border-bottom:1px solid #e3e7ef}.brand,a{color:#315bea;text-decoration:none;font-weight:600}.brand{color:#172033;font-size:21px;font-weight:800}nav{display:flex;gap:18px;align-items:center}nav a:hover{color:#173cae}main{width:min(100% - 32px,1000px);margin:44px auto}.panel,.course{padding:28px;background:#fff;border:1px solid #e2e6ee;border-radius:16px;box-shadow:0 12px 30px #1720330c}h1{margin:0 0 10px;font-size:32px}h2{margin:0 0 14px}p{color:#667085;line-height:1.5}label{display:block;margin:14px 0 6px;font-weight:600}input{width:100%;padding:11px 12px;border:1px solid #cbd1da;border-radius:9px;font:inherit}button{padding:10px 16px;border:0;border-radius:9px;background:#315bea;color:#fff;font:inherit;font-weight:700;cursor:pointer}button.secondary{background:#edf1f8;color:#315bea}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px}.notice{padding:14px;border-radius:9px;background:#fff}.error{color:#c62828}.success{color:#24733d}.hidden{display:none}
</style></head><body><header><a class="brand" asp-controller="Home" asp-action="Index">Goga</a><nav><a asp-controller="Home" asp-action="Index">Главная</a><a asp-controller="Courses" asp-action="Index">Курсы</a><a asp-controller="Timetable" asp-action="Index">Расписание</a>@if(User.Identity?.IsAuthenticated == true){<form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline"><button class="secondary" type="submit">Выйти</button></form>}else{<a asp-controller="Auth" asp-action="Login">Войти</a>}</nav></header>@RenderBody()</body></html>

@model RegisterViewModel
@{ ViewData["Title"] = "Регистрация"; }<main><section class="panel" style="max-width:460px;margin:auto"><h1>Регистрация</h1><p>Создайте аккаунт для доступа к приложению.</p><form asp-action="Register" method="post"><div asp-validation-summary="All" class="error"></div><label asp-for="Group"></label><input asp-for="Group"><small>Доступные демо-группы: ИС-101, БПИ-101</small><label asp-for="FirstName">Имя</label><input asp-for="FirstName"><label asp-for="LastName">Фамилия</label><input asp-for="LastName"><label asp-for="Email"></label><input asp-for="Email" type="email"><label asp-for="Password"></label><input asp-for="Password" type="password" minlength="8"><button type="submit">Зарегистрироваться</button></form><p><a asp-action="Login">Уже есть аккаунт? Войти</a></p></section></main>

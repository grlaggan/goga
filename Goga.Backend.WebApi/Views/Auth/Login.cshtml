@model LoginViewModel
@{ ViewData["Title"] = "Вход"; }<main><section class="panel" style="max-width:460px;margin:auto"><h1>Вход</h1><p>Войдите, чтобы открыть курсы и расписание.</p><form asp-action="Login" method="post"><div asp-validation-summary="All" class="error"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email"><label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="current-password"><button type="submit">Войти</button></form><p><a asp-action="Register">Создать аккаунт</a></p></section></main>
